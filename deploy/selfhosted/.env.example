TECHSTACK_IMAGE=ghcr.io/kombifyio/techstack
IMAGE_TAG=latest
TECHSTACK_BIND=127.0.0.1
TECHSTACK_PORT=5260
TECHSTACK_GRPC_BIND=127.0.0.1
TECHSTACK_GRPC_PORT=5263

# Generate both values before first start. Keep them secret and stable.
# openssl rand -hex 32
TECHSTACK_V2_SESSION_SECRET=
POSTGRES_PASSWORD=

# Set the HTTPS origin exposed by your trusted reverse proxy.
TECHSTACK_PUBLIC_ORIGIN=https://techstack.example.com
TECHSTACK_CORS_ORIGINS=https://techstack.example.com
