TECHSTACK_IMAGE=ghcr.io/kombifyio/techstack-open-core
IMAGE_TAG=
TECHSTACK_BIND=127.0.0.1
TECHSTACK_PORT=5260
TECHSTACK_GRPC_BIND=127.0.0.1
TECHSTACK_GRPC_PORT=5263

# Generate the session secret and database password before first start.
# Keep all three secrets stable across restarts and preserve them with backups.
# openssl rand -hex 32
TECHSTACK_V2_SESSION_SECRET=
POSTGRES_PASSWORD=

# Exactly 32 text bytes, used directly by AES-256-GCM (not base64-decoded).
# openssl rand -base64 24
TECHSTACK_ENCRYPTION_KEY=

# Set the HTTPS origin exposed by your trusted reverse proxy.
TECHSTACK_PUBLIC_ORIGIN=https://techstack.example.com
TECHSTACK_CORS_ORIGINS=https://techstack.example.com
