{
  "name": "techstack-app",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5261",
    "build": "vite build",
    "preview": "vite preview --port 5261",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:embedded": "playwright test --config=playwright.embedded.config.ts",
    "test:e2e:nosetup": "node ./scripts/run-playwright-nosetup.mjs",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.13.1",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.21.2",
    "@lucide/svelte": "1.20.0",
    "@sentry/sveltekit": "^10.51.0",
    "@tailwindcss/typography": "^0.5.19",
    "argon2-browser": "^1.18.0",
    "autoprefixer": "^10.4.22",
    "bits-ui": "^2.15.5",
    "clsx": "^2.1.0",
    "dompurify": "^3.4.1",
    "marked": "^15.0.12",
    "mdsvex": "^0.12.6",
    "postcss": "^8.5.12",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.0.0"
  },
  "overrides": {
    "cookie@<0.7.0": ">=0.7.0",
    "ws@>=8.0.0 <8.21.0": ">=8.21.0",
    "undici@>=7.0.0 <7.28.0": ">=7.28.0",
    "jsdom>undici": ">=7.28.0 <8.0.0"
  }
}
