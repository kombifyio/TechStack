{
  "name": "techstack-app",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5261",
    "build": "vite build",
    "preview": "vite preview --port 5261",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-i18n.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:i18n": "node scripts/check-i18n.mjs",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:ui": "node ./scripts/run-ui-gate.mjs",
    "test:e2e:embedded": "playwright test --config=playwright.embedded.config.ts",
    "test:e2e:nosetup": "node ./scripts/run-playwright-nosetup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "4.0.0-next.4",
    "@sveltejs/kit": "3.0.0-next.28",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.1",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.21.2",
    "@kombiverselabs/design": "0.10.376",
    "@kombiverselabs/embed": "0.10.2772",
    "@kombiverselabs/onboarding-core": "^0.10.376",
    "@kombiverselabs/ui": "^0.10.376",
    "@lucide/svelte": "1.20.0",
    "@sentry/sveltekit": "^10.70.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "argon2-browser": "^1.18.0",
    "autoprefixer": "^10.4.22",
    "clsx": "^2.1.1",
    "mdsvex": "^0.12.8",
    "postcss": "^8.5.28",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "cookie@<0.7.0": ">=0.7.0",
    "ws@>=8.0.0 <8.21.0": ">=8.21.0",
    "undici@>=7.0.0 <7.28.0": ">=7.28.0",
    "jsdom>undici": ">=7.28.0 <8.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
