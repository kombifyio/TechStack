{
  "name": "techstack-app",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.21.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5261",
    "build": "vite build",
    "preview": "vite preview --port 5261",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-i18n.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:i18n": "node scripts/check-i18n.mjs",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kombify/notifications": "npm:@kombiverselabs/cloud-notifications@0.3.120",
    "@kombiverselabs/execution-contracts": "0.13.7",
    "@kombiverselabs/speechkit-voiceagent-client": "0.77.7",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.28.2",
    "@kombiverselabs/design": "0.11.1",
    "@kombiverselabs/embed": "0.13.7",
    "@kombiverselabs/onboarding-core": "0.11.1",
    "@kombiverselabs/ui": "0.11.1",
    "@lucide/svelte": "1.53.0",
    "@sentry/sveltekit": "^10.76.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "argon2-browser": "^1.18.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "mdsvex": "^0.12.8",
    "postcss": "^8.5.29",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3"
  },
  "overrides": {
    "cookie@<0.7.0": ">=0.7.0",
    "ws@>=8.0.0 <8.21.0": ">=8.21.0",
    "undici@>=7.0.0 <7.28.0": ">=7.28.0",
    "jsdom>undici": ">=7.28.0 <8.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
