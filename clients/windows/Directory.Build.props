<Project>
  <PropertyGroup>
    <!-- Release versions come exclusively from the packager via -p:Version;
         everything else is a recognizable dev build. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Single pin for every project in this directory (kombify-Techstack-o1f). -->
    <WebView2SdkVersion>1.0.4258.31</WebView2SdkVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Kombify.TechStack.Client'">
    <!-- Compile-time editions must never reuse one another's incremental obj output. -->
    <DesktopEdition Condition="'$(DesktopEdition)' == ''">Local</DesktopEdition>
    <BaseIntermediateOutputPath>obj\$(DesktopEdition)\</BaseIntermediateOutputPath>
    <OutputPath>bin\$(DesktopEdition)\$(Configuration)\</OutputPath>
  </PropertyGroup>
</Project>
